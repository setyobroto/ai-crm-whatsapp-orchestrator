      "parameters": {
        "jsCode": "const r=$input.first().json;\nconst c=$('Konfigurasi Klien').first().json;\nconst batch=$('Ambil Hak Batch').first().json;\nif(r.tenant!==c.tenant || batch.tenant!==c.tenant) throw new Error('Tenant gateway salah');\nconst cap=Number(batch.policy?.maxPerBatch);\nif(!batch.acquired || !Number.isInteger(cap) || cap<1 || cap>5) return [{json:{_empty:true},pairedItem:{item:0}}];\nconst candidates=Array.isArray(r.candidates)?r.candidates.slice(0,cap):[];\nreturn candidates.length?candidates.map((x,i)=>({json:{...x,_empty:false,batchToken:batch.batchToken,_batchIndex:i,_batchTotal:candidates.length},pairedItem:{item:0}})):[{json:{_empty:true},pairedItem:{item:0}}];"
