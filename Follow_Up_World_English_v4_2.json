    {
      "parameters": {
        "jsCode": "function validateDraft(candidate, value) {\n    let parsed;\n    try {\n        parsed = typeof value === 'string' ? JSON.parse(value.trim().replace(/^```(?:json)?\\s*|\\s*```$/g, '')) : value;\n    } catch {}\n    const name = String(candidate.name || 'Kak').replace(/[\\r\\n\\t]/g,' ').slice(0,60);\n    const greeting = name && name.toLowerCase() !== 'kak' ? 'Halo Kak ' + name + '.' : 'Halo Kak.';\n    const business = String(candidate.business?.name || '').slice(0,100);\n    const cs = String(candidate.business?.csName || 'CS').slice(0,80);\n    const fallback = [\n        `${greeting} Saya ${cs} dari ${business}, menindaklanjuti obrolan tentang kursus. Bagian mana yang masih ingin Kakak tanyakan sebelum menentukan pilihan?`,\n        `${greeting} Apakah kendala utama Kakak saat ini jadwal atau pemilihan program? Saya bantu cek informasi yang masih dibutuhkan.`,\n        `${greeting} Apakah rencana kursusnya masih ingin dilanjutkan? Kalau waktunya belum cocok, boleh beri tahu kapan ingin dihubungi kembali.`\n    ][Math.max(0,Math.min(2,Number(candidate.stage || 1)-1))];\n    let message = typeof parsed?.message === 'string' ? parsed.message.trim() : '';\n    const risky = /\\b(diskon|subsidi|promo|DP|kuota|antrean|antrian|slot|gratis|potongan|ditutup|penutupan|deadline|tenggat|jaminan|dijamin|garansi)\\b|https?:\\/\\/|\\bwww\\.|\\bRp\\s*\\d|\\b(?:pasti|100%)\\s+(?:bisa|lulus|berhasil)/i;\n    const numbers = message.match(/\\d+/g) || [];\n    const facts = String(candidate.business?.facts || '') + ' ' + name;\n    const fallbackUsed = !message || message.length>1200 || risky.test(message) || numbers.some(x=>!facts.includes(x));\n    if (fallbackUsed) message = fallback;\n    return { message, summary: typeof parsed?.summary === 'string' ? parsed.summary.slice(0,1200) : '', objection: ['harga','jadwal','program','belum_diketahui'].includes(parsed?.objection) ? parsed.objection : 'belum_diketahui', fallbackUsed };\n}\n\nconst c=$('Satu Prospek per Giliran').itemMatching(0).json;const r=$input.first().json;const raw=r.choices?.[0]?.message?.content;return [{json:{...c,...validateDraft(c,raw)},pairedItem:{item:0}}];"
      },
